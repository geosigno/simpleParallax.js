{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/react"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "includes": ["!**/.claude"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // Faux positifs : Biome 2.6 infère le littéral (`false`) pour les champs de
        // classe initialisés puis mutés (singletons, flags), là où TS infère `boolean`.
        "noUnnecessaryConditions": "off"
      }
    }
  }
}
