{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/react"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "includes": ["!**/.claude"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // False positives: Biome 2.6 infers the literal (`false`) for class fields
        // that are initialized then mutated (singletons, flags), where TS infers `boolean`.
        "noUnnecessaryConditions": "off"
      }
    }
  }
}
